<Window x:Class="RevitSlopePlugin.UI.ConfiguredPipeSegmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Trechos"
        Height="600" Width="1120"
        MinHeight="560" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="EditableCellTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFF7E6"/>
            <Setter Property="BorderBrush" Value="#D59B2D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <EventSetter Event="GotKeyboardFocus" Handler="EditableTextBox_GotKeyboardFocus"/>
        </Style>

        <Style x:Key="ReadOnlyCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#F7F9FA"/>
            <Setter Property="Foreground" Value="#44515A"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="EditableCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FFF7E6"/>
            <Setter Property="BorderBrush" Value="#E1B75C"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Configurar trechos"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tipo de infraestrutura" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="cmbInfrastructure"
                          Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="Name"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="gridSegments"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  SelectionMode="Single"
                  SelectionUnit="CellOrRowHeader"
                  FontSize="13"
                  RowHeight="38"
                  HorizontalScrollBarVisibility="Disabled"
                  Background="White"
                  BorderBrush="#CCCCCC"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Trecho" Binding="{Binding Index}" Width="58" IsReadOnly="True" CellStyle="{StaticResource ReadOnlyCellStyle}"/>
                <DataGridTextColumn Header="Origem" Binding="{Binding OriginLabel}" Width="95" IsReadOnly="True" CellStyle="{StaticResource ReadOnlyCellStyle}"/>
                <DataGridTextColumn Header="Destino" Binding="{Binding DestinationLabel}" Width="95" IsReadOnly="True" CellStyle="{StaticResource ReadOnlyCellStyle}"/>
                <DataGridTextColumn Header="Distancia" Binding="{Binding DistanceText}" Width="85" IsReadOnly="True" CellStyle="{StaticResource ReadOnlyCellStyle}"/>
                <DataGridTemplateColumn Header="Tipo de tubo" Width="270" CellStyle="{StaticResource EditableCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding PipeTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding PipeTypeName, UpdateSourceTrigger=PropertyChanged}"
                                      MinHeight="28"
                                      Margin="4,3"
                                      Padding="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Inclinacao (%)" Width="115" CellStyle="{StaticResource EditableCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding SlopePercentText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Quantidade" Width="100" CellStyle="{StaticResource EditableCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding PipeQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Diametro (mm)" Width="115" CellStyle="{StaticResource EditableCellStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding DiameterMmText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditableCellTextBoxStyle}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Copiar ↓"
                                    ToolTip="Copiar valores para linhas abaixo"
                                    MinHeight="28"
                                    Margin="4,3"
                                    Padding="10,0"
                                    Background="#E8F0FE"
                                    Foreground="#1A73E8"
                                    BorderBrush="#B8CBF5"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="BtnCopyDown_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="btnCancel"
                    Content="Cancelar"
                    Style="{StaticResource BtnStyle}"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    Width="100"
                    Click="BtnCancel_Click"
                    Margin="0,0,10,0"/>

            <Button x:Name="btnCreate"
                    Content="Criar"
                    Style="{StaticResource BtnStyle}"
                    Background="#1A73E8"
                    Foreground="White"
                    Width="120"
                    Click="BtnCreate_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
