<Window x:Class="RevitSlopePlugin.UI.SewerSpreadsheetOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificar Planilha"
        Height="260" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Conferencia da planilha de esgoto"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Text="Aba da planilha" Style="{StaticResource LabelStyle}"/>
        <ComboBox x:Name="cmbSheets" Grid.Row="2" Style="{StaticResource ComboStyle}"/>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="Mapeamento" Style="{StaticResource LabelStyle}"/>
            <ComboBox x:Name="cmbMappings"
                      Style="{StaticResource ComboStyle}"
                      DisplayMemberPath="DisplayName"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar"
                    Style="{StaticResource BtnStyle}"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    Width="100"
                    Click="BtnCancel_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Verificar"
                    Style="{StaticResource BtnStyle}"
                    Background="#1A73E8"
                    Foreground="White"
                    Width="120"
                    IsDefault="True"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
