<Window x:Class="RevitSlopePlugin.UI.BoxPipeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Height="540" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Tubo entre caixas sem conector"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#333333"
                   Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Tipo de tubo" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="cmbPipeType" Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="Name" SelectedValuePath="Name"/>

                <TextBlock Text="Sistema de tubulacao" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="cmbSystemType" Style="{StaticResource ComboStyle}"
                          DisplayMemberPath="Name" SelectedValuePath="Name"/>

                <TextBlock Text="Diametro do tubo (mm)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtDiameter" Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Quantidade de tubos" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtPipeQuantity" Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Folga de nascimento - caixa 1 (cm)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtBirthClearance" Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Folga de chegada - caixa 2 (cm)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtArrivalClearance" Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Altura minima de caixa (cm)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtMinHeight" Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Altura maxima de caixa (cm)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtMaxHeight" Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Comportamento ao exceder limites" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="cmbLimitBehavior" Style="{StaticResource ComboStyle}"/>

                <TextBlock Text="Parametro de altura da caixa" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtHeightParameter" Style="{StaticResource InputStyle}"/>

                <TextBlock Text="Sentido do fluxo" Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="cmbFlowDirection" Style="{StaticResource ComboStyle}"/>

                <StackPanel Visibility="Collapsed">
                    <TextBlock Text="Cabecalho da coluna Extensao na planilha" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtSpreadsheetExtensionHeader" Style="{StaticResource InputStyle}"/>

                    <TextBlock Text="Mapeamentos planilha | prefixo | familias | parametro" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="txtSpreadsheetMappings"
                             Height="88"
                             FontSize="12"
                             Padding="8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="btnCancel"
                    Content="Cancelar"
                    Style="{StaticResource BtnStyle}"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    Width="100"
                    Click="BtnCancel_Click"
                    Margin="0,0,10,0"/>

            <Button x:Name="btnSave"
                    Content="Salvar"
                    Style="{StaticResource BtnStyle}"
                    Background="#1A73E8"
                    Foreground="White"
                    Width="120"
                    Click="BtnSave_Click"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
