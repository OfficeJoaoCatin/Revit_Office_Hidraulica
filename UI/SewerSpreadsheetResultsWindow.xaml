<Window x:Class="RevitSlopePlugin.UI.SewerSpreadsheetResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resultado da Planilha"
        Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtSummary"
                   Grid.Row="0"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#333333"
                   Margin="0,0,0,10"/>

        <DataGrid x:Name="gridResults"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="GridResults_SelectionChanged"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sev." Binding="{Binding Severity}" Width="70"/>
                <DataGridTextColumn Header="Trecho" Binding="{Binding SegmentCode}" Width="150"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="140"/>
                <DataGridTextColumn Header="Planilha" Binding="{Binding SheetValue}" Width="120"/>
                <DataGridTextColumn Header="Modelo" Binding="{Binding ModelValue}" Width="120"/>
                <DataGridTextColumn Header="Mensagem" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="btnWriteSpreadsheet"
                    Content="Atualizar planilha"
                    Width="150"
                    Height="34"
                    Background="#2E7D32"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnWriteSpreadsheet_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Fechar"
                    Width="100"
                    Height="34"
                    Background="#1A73E8"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
